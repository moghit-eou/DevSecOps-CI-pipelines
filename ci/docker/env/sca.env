# ci/docker/env/sca.env
# Runtime overrides for the SCA toolbox container.

# ci/ is baked into the image at /app/ci (see toolbox-base in
# ci/docker/Dockerfile) -- not in the project dir mounted at /workspace.
TRIVY_IGNOREFILE=/app/ci/suppress_trivy.yaml
OSV_IGNOREFILE=/app/ci/suppress_osv_scanner.toml

TRIVY_SARIF_OUTPUT=report-trivy.sarif
OSV_SARIF_OUTPUT=report-osv-scanner.sarif
SCA_MERGED_SARIF_OUTPUT=report-scan-merged.sarif

GATE_FAIL_THRESHOLD=8.0
GATE_WARN_THRESHOLD=5.0

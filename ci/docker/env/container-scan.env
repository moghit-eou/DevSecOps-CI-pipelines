# ci/docker/env/container-scan.env
# Runtime overrides for the container-scan toolbox container.

TRIVY_IGNOREFILE=/app/ci/suppress_trivy.yaml
OSV_IGNOREFILE=/app/ci/suppress_osv_scanner.toml

SEMGREP_CONFIG_RULESETS=/app/semgrep-rules/dockerfile auto

TRIVY_SCA_SARIF_OUTPUT=report-trivy-container-scan.sarif
OSV_SCA_SARIF_OUTPUT=report-osv-scanner-container-scan.sarif

OPENGREP_SAST_SARIF_OUTPUT=report-opengrep-dockerfile-scan.sarif
HADOLINT_SAST_SARIF_OUTPUT=report-hadolint-dockerfile-scan.sarif

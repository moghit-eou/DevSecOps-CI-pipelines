# ci/docker/env/sast.env
# Runtime overrides for the SAST toolbox container. Build-time defaults
# already live in ci/docker/Dockerfile (sast-toolbox stage); this file is
# for values you want to tweak WITHOUT rebuilding the image.

# semgrep-rules is cloned at build time into /app/semgrep-rules (baked into
# the image), unlike the native CI flow, where it's cloned into the repo
# root, so paths here must be absolute.
SEMGREP_CONFIG_RULESETS=/app/semgrep-rules/generic /app/semgrep-rules/problem-based-packs /app/semgrep-rules/bash /app/semgrep-rules/java auto /app/semgrep-rules/yaml /app/semgrep-rules/package_managers p/default

OPENGREP_SARIF_OUTPUT=report-sast-opengrep-app.sarif
# OPENGREP_EXCLUDE=*.sarif ci/ Dockerfile* .pre-commit-config.yaml docs/** README.md AGENTS.md